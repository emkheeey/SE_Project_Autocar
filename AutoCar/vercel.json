{
    "builds": [
        {
            "src": "AutoCar/build.sh",
            "use": "@vercel/static-build",
            "config": { "distDir": "AutoCar/staticfiles" }
        },
        {
            "src": "AutoCar/AutoCar/wsgi.py",
            "use": "@vercel/python",
            "config": { 
                "runtime": "python3.11",
                "maxLambdaSize": "15mb" 
            }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "AutoCar/AutoCar/wsgi.py"
        }
    ],
    "env": {
        "PYTHONPATH": "/var/task"
    }
}