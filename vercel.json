{
    "version": 2,
    "builds": [
        {
            "src": "build.sh",
            "use": "@vercel/static-build",
            "config": { 
                "distDir": "AutoCar/staticfiles_build" 
            }
        },
        {
            "src": "AutoCar/AutoCar/wsgi.py",
            "use": "@vercel/python",
            "config": { 
                "runtime": "python3.9",
                "maxLambdaSize": "15mb"
            }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "AutoCar/AutoCar/wsgi.py"
        }
    ],
    "env": {
        "PYTHONPATH": "/var/task",
        "DEBUG": "False",
        "DJANGO_SETTINGS_MODULE": "AutoCar.settings",
        "ALLOWED_HOSTS": "localhost,127.0.0.1,.vercel.app"
    }
}